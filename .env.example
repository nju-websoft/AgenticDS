# Copy to .env, supply credentials locally, then source it before running.
AGENTICDS_LLM_API_BASE_URL="https://api.example.org/v1"
AGENTICDS_LLM_API_KEY=""
AGENTICDS_LLM_MODEL_NAME="GLM-5.2"

AGENTICDS_KG_DIR="KG/snapshot"
AGENTICDS_INDEX_CACHE_DIR="index_cache"
AGENTICDS_CACHE_DIR="cache"
AGENTICDS_EMBEDDING_MODEL_NAME="Qwen/Qwen3-Embedding-0.6B"
AGENTICDS_LOCAL_EMBEDDING_DEVICE="cuda:0"
# Set true after the embedding model has been downloaded to the HF cache.
AGENTICDS_HF_LOCAL_FILES_ONLY="false"

# Constraint handling: fallback (default) or discard; unknown fields are retained.
AGENTICDS_CONSTRAINT_VIOLATION_POLICY="fallback"
# Round selection: lexicographic (default) or utility.
AGENTICDS_ROUND_SELECTION_POLICY="lexicographic"
# U = weight * quality + (1 - weight) * intent coverage.
AGENTICDS_ROUND_UTILITY_QUALITY_WEIGHT="0.7"

# Lucene runs inside the query/indexing process on the CPU.
AGENTICDS_LUCENE_JVM_HEAP="4g"
# Optional override; default is $AGENTICDS_CACHE_DIR/lucene/9.12.2.
# AGENTICDS_LUCENE_JAR_DIR="cache/lucene/9.12.2"
